{
  "name": "functions",
  "description": "Cloud Functions — logic nghiệp vụ ứng dụng bán hàng đồ điện tử (Flutter + Firebase)",
  "scripts": {
    "build": "tsc",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "test": "firebase emulators:exec --only firestore,functions,auth \"node --test\""
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^13.2.0",
    "firebase-functions": "^6.3.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "private": true
}