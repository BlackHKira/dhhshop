# Copy file này thành `.env` rồi điền giá trị thật.
#
# `.env` đã bị .gitignore chặn nên không bao giờ lên GitHub. Đừng ghi key
# thật vào file này — file này được commit.
#
# Chạy:  node --env-file=.env scripts/gen_embeddings.mjs

# Gemini API key, tạo ở Google AI Studio. Nên giới hạn key chỉ cho phép
# Generative Language API và đặt hạn mức chi phí.
GEMINI_API_KEY=
