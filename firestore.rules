rules_version = '2';

/* ============================================================
   DHHShop — Firestore Security Rules
   Cấu trúc 18 entity / 6 nhóm A–F (đặc tả de-tai-tong-the.md §12)

   Gói Spark: KHÔNG deploy Cloud Functions ở production, nên file này là
   tầng kiểm tra DUY NHẤT. Không có tầng server nào chạy lại phía sau.
   Vì vậy ở đây dùng nhiều ngoặc rõ ràng thay vì để && / || trộn mặc định
   — sai một ngoặc là lộ dữ liệu.
   ============================================================ */

service cloud.firestore {
  match /databases/{database}/documents {

    /* ═══════════════ helper ═══════════════ */

    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return request.auth.uid == uid; }
    function now() { return request.time; }

    /* Vai trò của người đang đăng nhập, đọc trực tiếp từ doc user.
       Không dùng custom claims vì cần Admin SDK để đặt, mà MVP không có. */
    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isCustomer() { return role() == 'customer'; }
    function isAdmin()    { return role() == 'admin'; }
    /* seller + admin = mọi quyền vận hành cửa hàng */
    function isStaff()    { return role() in ['seller', 'admin']; }

    function validRole(r) { return r in ['customer', 'seller', 'admin']; }


    /* ═══════════════════════════════════════════
       NHÓM A — Định danh, phân quyền & cấu hình (4 entity)
       ═══════════════════════════════════════════ */

    /* users/{uid}
       Role nằm thẳng trên doc này, không cần collection roles: danh sách
       vai trò là hằng số của hệ thống, không phải dữ liệu do người dùng
       tự quản lý. */
    match /users/{uid} {

      allow get:  if signedIn() && (isSelf(uid) || isStaff());
      allow list: if isStaff();

      /* Đăng ký: chỉ tạo chính mình, role mặc định customer.
         Chặn tự tạo tài khoản admin — không có chỗ này thì ai cũng tự
         nâng quyền được. */
      allow create: if isSelf(uid)
                    && request.resource.data.role == 'customer'
                    && validRole(request.resource.data.role)
                    && request.resource.data.email is string
                    && request.resource.data.email.size() > 0
                    && request.resource.data.is_active == true
                    && request.resource.data.created_at == now();

      /* Sửa hồ sơ: CHỈ admin được sửa bất kỳ tài khoản nào (kể cả đổi role),
         khách chỉ sửa được hồ sơ của chính mình và KHÔNG đổi được role.
         Không dùng isStaff() ở đây — nếu có, seller sẽ tự nâng mình
         (hoặc nâng bất kỳ ai) lên admin. Đây là leo thang đặc quyền. */
      allow update: if isAdmin()
                    || (isSelf(uid)
                        && isCustomer()
                        && request.resource.data.role == resource.data.role);

      /* Không cho xoá tài khoản — dùng is_active = false để khoá, giữ lại
         lịch sử đơn và audit log. Admin xoá được khi thật sự cần. */
      allow delete: if isAdmin();
    }

    /* users/{uid}/addresses/{addrId} — sổ địa chỉ riêng của khách */
    match /users/{uid}/addresses/{addrId} {
      allow read:    if signedIn() && (isSelf(uid) || isStaff());
      allow create, update: if isSelf(uid) && isCustomer();
      allow delete:  if isSelf(uid) && isCustomer();
    }

    /* settings/store — doc cố định, MVP chỉ một cửa hàng.
       bank_bin / bank_account_no / bank_account_name là dữ liệu CÔNG KHAI
       (khách cần đọc để dựng VietQR), không phải secret → read cho tất cả. */
    match /settings/store {
      allow read:  if true;
      allow write: if isAdmin();
    }

    /* delivery_zones/{zoneId} — docID = {city}_{district} chống trùng vùng */
    match /delivery_zones/{zoneId} {
      allow read:  if true;
      allow write: if isAdmin();
    }


    /* ═══════════════════════════════════════════
       NHÓM B — Catalog điện tử (3 entity)
       ═══════════════════════════════════════════ */

    match /categories/{catId} {

      /* Tên danh mục hiện thẳng lên storefront nên bắt buộc là chuỗi
         không rỗng và có trần độ dài. Rules không trim được, nên một chuỗi
         toàn khoảng trắng vẫn lọt — phần chuẩn hoá nằm ở client
         (core/validation.dart), ở đây chỉ chặn cái rõ ràng là sai. */
      function validCategory() {
        return request.resource.data.name is string
            && request.resource.data.name.size() > 0
            && request.resource.data.name.size() <= 60
            && (!('sort_order' in request.resource.data)
                || (request.resource.data.sort_order is int
                    && request.resource.data.sort_order >= 0));
      }

      allow read:   if true;
      allow create: if isStaff() && validCategory();
      allow update: if isStaff() && validCategory();
      allow delete: if isStaff();
    }

    /* products/{productId} — TUYỆT ĐỐI KHÔNG chứa trường tồn kho.
       Lý do xem ở collection inventory bên dưới. */
    match /products/{productId} {

      function validProduct() {
        return request.resource.data.name is string
            && request.resource.data.name.size() > 0
            && request.resource.data.name.size() <= 120
            && request.resource.data.price is number
            && request.resource.data.price >= 0
            && request.resource.data.category_id is string
            && request.resource.data.sku is string
            && request.resource.data.sku.size() > 0
            && request.resource.data.sku.size() <= 40
            && request.resource.data.is_available is bool
            /* Ảnh base64 nằm ngay trong doc nên Firestore giới hạn 1 MiB cho
               MỘT tài liệu. Chặn ở đây thay vì để Firestore từ chối bằng
               thông báo mơ hồ — người bán thấy luôn nguyên nhân và có thể
               chọn ảnh nhỏ hơn. Ngưỡng phải khớp kMaxImageBase64Length
               trong client/lib/core/validation.dart. */
            && (!('image_data' in request.resource.data)
                || (request.resource.data.image_data is string
                    && request.resource.data.image_data.size() <= 700000))
            /* chặn lọt field tồn kho vào doc sản phẩm */
            && !request.resource.data.keys().hasAny(
                 ['stock_on_hand', 'stock_reserved', 'stock_available']);
      }

      allow read:   if true;
      allow create: if isStaff() && validProduct();
      allow update: if isStaff() && validProduct();
      allow delete: if isStaff();
    }

    /* products/{productId}/specs/{specKey} — ram | rom | screen | battery | ... */
    match /products/{productId}/specs/{specKey} {

      /* Giá trị thông số hiện thẳng lên trang chi tiết nên phải là chuỗi
         có trần độ dài; trần này khớp kMaxSpecValueLength ở client. */
      function validSpec() {
        return request.resource.data.value is string
            && request.resource.data.value.size() <= 120;
      }

      allow read:  if true;
      allow create, update: if isStaff() && validSpec();
      allow delete: if isStaff();
    }


    /* ═══════════════════════════════════════════
       NHÓM C — Kho chung (2 entity)
       ═══════════════════════════════════════════ */

    /* inventory/{productId}

       VÌ SAO PHẢI TÁCH RIÊNG products, KHÔNG GỘP stock VÀO DOC SẢN PHẨM:
       seller được quyền ghi products (để sửa tên / giá / ảnh). Nếu stock
       nằm trong cùng document thì seller cũng tự set tồn kho được mà không
       cần đi qua quy trình stock_movements. Tách ra thì khóa được đúng:
       sửa mô tả sản phẩm và sửa tồn là hai quyền khác nhau.

       stock_available là trường DERIVED. Client tính và ghi kèm trong
       transaction, nhưng Rules vẫn kiểm được bằng BẤT BIẾN HIỆU:

           Δavailable == Δon_hand − Δreserved

       Bất biến này đúng với mọi nghiệp vụ hợp lệ:
         nhập kho      +q  →  Δon_hand +q, Δreserved  0  →  Δavailable +q
         reserve       +q  →  Δon_hand  0, Δreserved +q  →  Δavailable −q
         bán (deduct) +q  →  Δon_hand −q, Δreserved −q  →  Δavailable  0
         release       +q  →  Δon_hand  0, Δreserved −q  →  Δavailable +q
       Nên client bơm available để lách chống oversell sẽ vi phạm bất biến
       và bị chặn.

       GIỚI HẠN ĐÃ BIẾT — nói thẳng để không tự lừa mình: Rules chỉ kiểm
       được QUAN HỆ giữa ba con số, không biết con số đó có thật hay không.
       Một tài khoản seller (hay admin) vẫn có thể ghi thẳng stock_on_hand
       thành số tuỳ ý — vì điều chỉnh tồn vốn là việc hợp lệ của họ.
       Cái thật sự chặn bịa đặt là:
         1. mọi thay đổi tồn phải kèm một dòng stock_movements có lý do và
            actor, và dòng đó không sửa / không xoá được;
         2. admin đọc audit_logs để đối chiếu tồn với nhập xuất thực tế.
       Đây là giới hạn cấu trúc của mọi hệ thống mà logic nằm ở client,
       không phải lỗi của Rules. Nếu cần chặn tuyệt đối thì phải có
       Cloud Functions kiểm tra lại — tức là rời gói Spark. */
    match /inventory/{productId} {

      function validStock() {
        return request.resource.data.stock_on_hand is int
            && request.resource.data.stock_on_hand >= 0
            && request.resource.data.stock_reserved is int
            && request.resource.data.stock_reserved >= 0
            && request.resource.data.stock_available is int
            && request.resource.data.stock_available >= 0
            && request.resource.data.stock_reserved <= request.resource.data.stock_on_hand
            && request.resource.data.updated_at == now();
      }

      /* Bất biến hiệu — xem giải thích bên trên. */
      function availableFollowsDelta() {
        return request.resource.data.stock_available - resource.data.stock_available
             == (request.resource.data.stock_on_hand - resource.data.stock_on_hand)
              - (request.resource.data.stock_reserved - resource.data.stock_reserved);
      }

      allow read: if true;

      /* Lúc tạo mới thì chưa có giá trị cũ để so delta: chỉ kiểm available
         bằng đúng on_hand − reserved (tức reserved khởi tạo bằng 0). */
      allow create: if isStaff()
                    && validStock()
                    && request.resource.data.stock_available
                       == request.resource.data.stock_on_hand
                          - request.resource.data.stock_reserved;

      allow update: if isStaff() && validStock() && availableFollowsDelta();
    }

    /* stock_movements/{auto} — nhật ký mọi biến động tồn.
       Bắt buộc có lý do + actor để truy vết được vì sau không sửa được. */
    match /stock_movements/{movementId} {

      function validMovement() {
        return request.resource.data.type in
                 ['purchase', 'reserve', 'sale_online', 'adjustment', 'return', 'release']
            && request.resource.data.quantity is int
            && request.resource.data.quantity != 0
            && request.resource.data.reason is string
            && request.resource.data.reason.size() > 0
            && request.resource.data.product_id is string
            && request.resource.data.actor_id == request.auth.uid
            && request.resource.data.created_at == now();
      }

      allow read:   if isStaff();
      allow create: if isStaff() && validMovement();
      allow update, delete: if false;
    }


    /* ═══════════════════════════════════════════
       NHÓM D — Giỏ hàng & Đơn online (5 entity)
       ═══════════════════════════════════════════ */

    /* users/{uid}/carts/active — doc cố định nên chỉ có 1 giỏ active/khách.
       Xoá doc này khi đơn chuyển sang converted / abandoned. */
    match /users/{uid}/carts/active {

      allow read:   if signedIn() && (isSelf(uid) || isStaff());
      allow create, update: if isSelf(uid) && isCustomer();
      allow delete: if signedIn() && (isSelf(uid) || isStaff());

      /* items/{productId} — docID = productId chống trùng dòng hàng */
      match /items/{productId} {
        allow read:   if signedIn() && (isSelf(uid) || isStaff());
        allow create, update: if isSelf(uid) && isCustomer()
                              && request.resource.data.quantity is int
                              && request.resource.data.quantity > 0
                              && request.resource.data.created_at == now();
        allow delete: if signedIn() && (isSelf(uid) || isStaff());
      }
    }

    /* orders/{idempotencyKey}
       docID là idempotency key do client sinh → bấm "Đặt" hai lần chỉ tạo
       một đơn, không cần cờ chống trùng riêng. */
    match /orders/{orderId} {

      function orderUserId() {
        return get(/databases/$(database)/documents/orders/$(orderId)).data.user_id;
      }

      function validOrder() {
        return request.resource.data.user_id is string
            && request.resource.data.status in
                 ['pending', 'confirmed', 'packing', 'shipped', 'delivered', 'completed', 'canceled']
            && request.resource.data.payment_method in ['cod', 'bank_transfer']
            && request.resource.data.payment_status in ['unpaid', 'paid', 'refunded']
            && request.resource.data.subtotal is number
            && request.resource.data.subtotal >= 0
            && request.resource.data.delivery_fee is number
            && request.resource.data.delivery_fee >= 0
            && request.resource.data.total is number
            && request.resource.data.total ==
                 request.resource.data.subtotal + request.resource.data.delivery_fee
            && request.resource.data.receiver_name is string
            && request.resource.data.receiver_name.size() > 0
            && request.resource.data.phone is string
            && request.resource.data.address_line is string
            && request.resource.data.district is string
            && request.resource.data.city is string
            && request.resource.data.created_at == now();
      }

      /* Huỷ đơn luôn phải có lý do — không cho huỷ im lặng. */
      function cancelHasReason() {
        return request.resource.data.status != 'canceled'
            || (request.resource.data.cancel_reason is string
                && request.resource.data.cancel_reason.size() > 0
                && request.resource.data.canceled_by == request.auth.uid);
      }

      /* Bước chuyển trạng thái hợp lệ — 6 bước, xem §8.3.
         Không có nhánh giao thất bại: cửa hàng tự giao, không có người giao
         riêng nên không ai để báo cáo thất bại, không có trạng thái cho việc đó. */
      function validTransition(from, to) {
        return (from == 'pending'   && to in ['confirmed', 'canceled'])
            || (from == 'confirmed' && to in ['packing', 'canceled'])
            || (from == 'packing'   && to in ['shipped', 'canceled'])
            || (from == 'shipped'   && to in ['delivered', 'canceled'])
            || (from == 'delivered' && to == 'completed')
            || (from == to);
      }

      /* Khách tự lo: KHÔNG được chốt thu tiền, không được đổi tổng tiền,
         không được tự chuyển trạng thái đi xa hơn huỷ. */
      function customerFieldsUntouched() {
        return !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['payment_status', 'total', 'subtotal', 'delivery_fee']);
      }

      allow get:  if signedIn()
                   && (resource.data.user_id == request.auth.uid || isStaff());
      allow list: if isStaff();

      allow create: if isSelf(request.auth.uid) && isCustomer()
                    && request.resource.data.user_id == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.payment_status == 'unpaid'
                    && validOrder();

      allow update: if signedIn() && validOrder() && cancelHasReason()
                    && (
                         /* khách chỉ huỷ đơn của mình, và chỉ khi chưa xác nhận */
                         (isCustomer() && resource.data.user_id == request.auth.uid
                            && customerFieldsUntouched()
                            && resource.data.status == 'pending'
                            && request.resource.data.status == 'canceled')
                         /* seller / admin vận hành đơn theo state machine */
                      || (isStaff()
                            && validTransition(resource.data.status,
                                               request.resource.data.status))
                       );

      /* Không xoá đơn — giữ lại để tra cứu, huỷ bằng trạng thái canceled. */
      allow delete: if false;

      /* orders/{orderId}/items/{productId} — snapshot tên SP + đơn giá.
         Chỉ tạo được lúc đơn còn pending, sau đó đóng băng để lịch sử
         đơn không bị sửa sau lưu. */
      match /items/{productId} {
        allow read: if signedIn() && (orderUserId() == request.auth.uid || isStaff());
        allow create: if isCustomer() && orderUserId() == request.auth.uid
                      && get(/databases/$(database)/documents/orders/$(orderId))
                           .data.status == 'pending'
                      && request.resource.data.product_name is string
                      && request.resource.data.unit_price is number
                      && request.resource.data.unit_price >= 0
                      && request.resource.data.quantity is int
                      && request.resource.data.quantity > 0;
        allow update, delete: if false;
      }

      /* orders/{orderId}/history/{auto} — nhật ký mọi chuyển trạng thái.
         Bắt buộc phải là chủ đơn hoặc staff mới ghi được: nếu thiếu điều
         kiện sở hữu thì bất kỳ ai đăng nhập cũng chèn được dòng log giả
         vào đơn của người khác, làm sai lịch sử tra cứu. */
      match /history/{historyId} {
        allow read:  if signedIn() && (orderUserId() == request.auth.uid || isStaff());
        allow create: if signedIn()
                      && (orderUserId() == request.auth.uid || isStaff())
                      && request.resource.data.from_status is string
                      && request.resource.data.to_status in
                           ['pending', 'confirmed', 'packing', 'shipped', 'delivered', 'completed', 'canceled']
                      && request.resource.data.actor_id == request.auth.uid
                      && request.resource.data.created_at == now();
        allow update, delete: if false;
      }
    }


    /* ═══════════════════════════════════════════
       NHÓM E — Thanh toán (1 entity)
       ═══════════════════════════════════════════ */

    /* payments/{orderId} — docID = orderId nên mỗi đơn chỉ có ĐÚNG MỘT
       bản ghi thanh toán: bấm xác nhận lần hai sẽ bị chặn, không tạo
       payment kép, không cộng tiền hai lần. */
    match /payments/{orderId} {

      function orderDoc() {
        return get(/databases/$(database)/documents/orders/$(orderId));
      }
      function validPayment() {
        return request.resource.data.order_id == orderId
            && request.resource.data.method in ['cod', 'bank_transfer']
            && request.resource.data.status in ['pending', 'paid', 'refunded']
            && request.resource.data.amount is number
            && request.resource.data.amount >= 0
            && request.resource.data.amount == orderDoc().data.total;
      }
      /* Đơn COD phải có tiền đã thu + ai thu + lúc thu, ghi trong cùng
         transaction với bước delivered nên không thể có đơn đã giao mà
         chưa ghi nhận tiền mặt. */
      function codHasProof() {
        return request.resource.data.method != 'cod'
            || (request.resource.data.status != 'paid'
                || (request.resource.data.cod_collected_amount is number
                    && request.resource.data.cod_collected_amount > 0
                    && request.resource.data.collected_by == request.auth.uid
                    && request.resource.data.collected_at == now()));
      }

      allow read: if signedIn() && (orderDoc().data.user_id == request.auth.uid || isStaff());

      allow create: if isStaff() && validPayment() && codHasProof();

      allow update: if isStaff() && validPayment() && codHasProof()
                    /* paid → refunded phải có lý do để truy vết hoàn tiền */
                    && (request.resource.data.status != 'refunded'
                        || resource.data.status == 'paid')
                    && (request.resource.data.status != 'refunded'
                        || (request.resource.data.refund_reason is string
                            && request.resource.data.refund_reason.size() > 0));

      /* Không xoá — giữ dấu vết tài chính. Admin xoá được nếu thật sự cần. */
      allow delete: if isAdmin();
    }


    /* ═══════════════════════════════════════════
       NHÓM F — Chatbot & Audit (3 entity)
       ═══════════════════════════════════════════ */

    /* chat_conversations/{convId} — hội thoại riêng của khách */
    match /chat_conversations/{convId} {

      allow get: if signedIn()
                 && (resource.data.user_id == request.auth.uid || isAdmin());

      /* list không kiểm được từng doc; Rules chỉ cho hỏi, còn client BẮT BUỘC
         query kèm where user_id == uid, nếu không sẽ nhận rỗng. */
      allow list: if isCustomer() || isAdmin();

      allow create: if isCustomer() && request.resource.data.user_id == request.auth.uid
                    && request.resource.data.status == 'active';

      allow update: if signedIn() && resource.data.user_id == request.auth.uid
                    && request.resource.data.user_id == resource.data.user_id;

      allow delete: if (signedIn() && resource.data.user_id == request.auth.uid) || isAdmin();

      match /messages/{messageId} {
        allow read: if signedIn()
                    && (get(/databases/$(database)/documents/chat_conversations/$(convId))
                         .data.user_id == request.auth.uid || isAdmin());
        allow create: if isCustomer()
                      && get(/databases/$(database)/documents/chat_conversations/$(convId))
                           .data.user_id == request.auth.uid
                      && request.resource.data.role in ['user', 'assistant', 'system']
                      && request.resource.data.content is string
                      && request.resource.data.content.size() > 0
                      && request.resource.data.content.size() <= 4000
                      && request.resource.data.created_at == now();
        /* Nội dung chat là bằng chứng, không sửa được sau khi gửi. */
        allow update, delete: if false;
      }
    }

    /* audit_logs/{auto} — bằng chứng chính thức khi có tranh chấp về giá,
       tồn kho hay trạng thái đơn. Không sửa, không xoá bởi bất kỳ ai, kể cả admin. */
    match /audit_logs/{logId} {
      allow read:  if isAdmin();
      allow create: if isStaff()
                    && request.resource.data.user_id == request.auth.uid
                    && request.resource.data.action is string
                    && request.resource.data.target_type is string
                    && request.resource.data.target_id is string
                    && request.resource.data.created_at == now();
      allow update, delete: if false;
    }


    /* ═══════════════════════════════════════════
       Chặn mặc định: mọi path chưa khai báo ở trên đều bị từ chối.
       Không có dòng này thì Firestore cho phép truy cập.
       ═══════════════════════════════════════════ */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
